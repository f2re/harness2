# Harness² example configuration. Copy to .env and fill only the routes you use.

# Shared Vertex configuration (OpenCode, improver, judges, WorkBuddy model proxy)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
HARNESS2_SOLVER_MODEL=google-vertex/gemini-3.5-flash
HARNESS2_IMPROVER_MODEL=google-vertex/gemini-3.5-flash
HARNESS2_JUDGE_MODEL=gemini-3.5-flash

# Optional output root
# HARNESS2_RUNS_DIR=./runs

# Codex / Responses endpoint. `harness2-bridge` prints working values when used.
# HARNESS2_CODEX_BASE_URL=http://127.0.0.1:8787/v1
# HARNESS2_CODEX_CONTAINER_URL=http://host.docker.internal:8787/v1
# HARNESS2_CODEX_API_KEY=
# HARNESS2_CODEX_MODEL=gemini-3.5-flash

# Claude Code host executor (JobBench / LAB). Empty model = CLI configured default.
# HARNESS2_CLAUDE_BIN=claude
# HARNESS2_CLAUDE_MODEL=

# Antigravity host executor (JobBench / LAB). Empty model = CLI configured default.
# HARNESS2_ANTIGRAVITY_BIN=agy
# HARNESS2_ANTIGRAVITY_MODEL=

# WorkBuddy Antigravity runs inside Harbor and cannot use a desktop keyring.
# Set one of these API-key names. HARNESS2_ANTIGRAVITY_API_KEY takes precedence.
# HARNESS2_ANTIGRAVITY_API_KEY=
# GEMINI_API_KEY=
# Optional Gemini-compatible endpoint for Antigravity:
# HARNESS2_ANTIGRAVITY_BASE_URL=
# GOOGLE_GEMINI_BASE_URL=

# Optional separate JobBench judge endpoint instead of the generated Vertex endpoint.
# HARNESS2_JUDGE_BASE_URL=
# HARNESS2_JUDGE_API_KEY=
